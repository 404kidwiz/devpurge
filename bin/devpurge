#!/usr/bin/env bash
set -eo pipefail
# DevPurge - The cinematic, zero-bs cache sweeper for modern developers.

VERSION="3.3.0"
# Resolve the installed symlink before locating the adjacent source tree.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
DIR="$(cd "$(dirname "$SCRIPT_PATH")/../src" && pwd)"

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Core Engine
export DRY_RUN=false
# shellcheck source=src/config.sh
source "$DIR/config.sh"
# shellcheck source=src/utils.sh
source "$DIR/utils.sh"

# Dynamic Plugin Architecture
MODULES=()
DESCRIPTIONS=()
CACHE_MODULES=(uv node lang mac system)

# Load all plugins organically
for mod in "$DIR"/modules/*.sh; do
  [ -e "$mod" ] || continue
  # Plugins are checked individually; their paths are discovered at runtime.
  # shellcheck source=/dev/null
  source "$mod"
  # Extract filename without extension for logic targeting
  base_name=$(basename "$mod" .sh)
  
  # Scrape description header
  desc=$(sed -n 's/^# DESC: //p' "$mod")
  if [ -z "$desc" ]; then desc="Custom Plugin ($base_name)"; fi
  
  MODULES+=("$base_name")
  DESCRIPTIONS+=("$desc")
done

show_help() {
  echo -e "${BLUE}=======================================${NC}"
  echo -e "${GREEN}   DevPurge v${VERSION} - The OS Sweeper${NC}"
  echo -e "${BLUE}=======================================${NC}"
  echo "Usage: devpurge [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  --gui        Open the local graphical storage dashboard"
  echo "  --scan       Read-only size, activity, and cleanup eligibility report"
  echo "  --scan --json  Machine-readable report (cannot mix with cleanup flags)"
  echo "  --dry-run    Preview targets; directory sizes are not guaranteed savings"
  echo "  --all        Clean caches only: uv, node, lang, mac, system"
  echo "               AI history, Docker and Git require explicit module flags"
  for i in "${!MODULES[@]}"; do
    printf "  --%-10s Sweep %s\n" "${MODULES[$i]}" "${DESCRIPTIONS[$i]}"
  done
  echo "  --install    Install the CLI only; no background cleanup"
  echo "  --background Scheduled cache cleanup (requires automated_sweep: true)"
  echo "  --yes        Confirm --docker without the typed 'prune docker' prompt"
  echo "  --uninstall  Remove the background daemon"
  echo "  --help       Show this menu"
  echo ""
  echo "Run 'devpurge' natively to open the interactive TUI."
}

run_if_allowed() {
  local target_name=$1
  if [[ " $IGNORE_TARGETS " == *" $target_name "* ]]; then
    echo -e "${RED}[IGNORED by Config] $target_name${NC}"
  else
    if [ "$RESCUE_MODE" = true ] && [[ "$target_name" =~ ^(ai|docker|git)$ ]]; then
      log_action "[SKIPPED] $target_name cannot be rescued to Trash"
      return 0
    fi
    if type "sweep_$target_name" &>/dev/null; then
      "sweep_$target_name"
    else
      echo -e "${RED}Error: Function sweep_$target_name not found in plugin!${NC}"
      return 1
    fi
  fi
}

show_tui() {
  echo -e "\n${BLUE}=======================================${NC}"
  echo -e "${GREEN}   DevPurge v${VERSION} Interactive UI${NC}"
  echo -e "${BLUE}=======================================${NC}\n"
  
  if [ "$RESCUE_MODE" = "true" ]; then
    echo -e "  ${YELLOW}Rescue Mode: paths go to Trash; command cleanup is skipped.${NC}\n"
  fi

  echo "Enter a number/key and press Return, or (Q) to quit:"
  echo "  [A] 🧹 Clean caches only (Respects config overrides)"
  echo "  AI, Docker and Git entries can remove history or persistent data."
  
  # Dynamically list loaded plugins
  counter=1
  for i in "${!MODULES[@]}"; do
    echo "  [$counter] 📦 ${DESCRIPTIONS[$i]}"
    counter=$((counter+1))
  done

  echo "  -------------------------------------"
  echo "  [D] 🔍 Toggle Dry Run (Currently: $DRY_RUN)"
  echo "  [Q] 🚪 Quit"
  
  read -r input
  
  if [[ "$input" == "A" || "$input" == "a" ]]; then
    for mod in "${CACHE_MODULES[@]}"; do run_if_allowed "$mod"; done
  elif [[ "$input" == "D" || "$input" == "d" ]]; then
    if [ "$DRY_RUN" = true ]; then DRY_RUN=false; else DRY_RUN=true; fi
    clear && show_tui
  elif [[ "$input" == "Q" || "$input" == "q" ]]; then
    echo -e "\nExiting."; exit 0
  elif [[ "$input" =~ ^[0-9]+$ ]] && [ "$input" -gt 0 ] && [ "$input" -le "${#MODULES[@]}" ]; then
    local target_idx=$((input-1))
    run_if_allowed "${MODULES[$target_idx]}"
  else
    echo ""; show_tui
  fi
}

install_daemon() {
  bash "$DIR/../install.sh"
}

uninstall_daemon() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    launchctl unload ~/Library/LaunchAgents/com.devpurge.sweeper.plist 2>/dev/null
    rm -f ~/Library/LaunchAgents/com.devpurge.sweeper.plist
  else
    systemctl --user disable --now devpurge.timer devpurge.service 2>/dev/null
    rm -f ~/.config/systemd/user/devpurge.*
  fi
  echo -e "${GREEN}[✔] Daemon uninstalled.${NC}"
}

# Validate every option before any action, including options after a module.
BACKGROUND=false
MAINTENANCE=false
SCAN=false
JSON_REPORT=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --background) BACKGROUND=true ;;
    --scan) SCAN=true ;;
    --json) JSON_REPORT=true ;;
    --install|--uninstall) MAINTENANCE=true ;;
    --all|--help|--gui) ;;
    --yes) export DEVPURGE_YES=true ;;
    --*)
      found=false
      for mod in "${MODULES[@]}"; do
        if [ "$arg" = "--$mod" ]; then found=true; break; fi
      done
      if [ "$found" = false ]; then echo "Unknown option: $arg" >&2; exit 1; fi
      ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done
for arg in "$@"; do
  if [ "$arg" = --gui ]; then
    if [ "$#" -ne 1 ]; then echo "--gui must be run alone." >&2; exit 1; fi
    exec python3 "$DIR/gui.py"
  fi
done
if [ "$JSON_REPORT" = true ] && [ "$SCAN" = false ]; then
  echo "--json requires --scan." >&2
  exit 1
fi
if [ "$SCAN" = true ]; then
  for arg in "$@"; do
    case "$arg" in
      --scan|--json|--dry-run) ;;
      *) echo "--scan cannot be combined with cleanup or maintenance options." >&2; exit 1 ;;
    esac
  done
  report_args=()
  if [ "$JSON_REPORT" = true ]; then report_args+=(--json); fi
  exec python3 "$DIR/report.py" "${report_args[@]}"
fi
if [ "$MAINTENANCE" = true ] && [ "$#" -ne 1 ]; then
  echo "Install/uninstall must be run alone; dry-run never installs or uninstalls." >&2
  exit 1
fi
if [ "$BACKGROUND" = true ]; then
  for arg in "$@"; do
    case "$arg" in
      --background|--all|--dry-run) ;;
      *) echo "Background jobs may only run --all (cache cleanup)." >&2; exit 1 ;;
    esac
  done
  if [ "$AUTO_SWEEP" != true ]; then
    echo "Scheduled cleanup disabled by automated_sweep configuration."
    exit 0
  fi
fi
for arg in "$@"; do
  if [ "$arg" = --help ]; then show_help; exit 0; fi
done

if [ $# -eq 0 ]; then
  DRY_RUN=true
  clear
  show_tui
  exit 0
fi

ran_something=false
ran_background=false

for arg in "$@"; do
  case $arg in
    --dry-run|--background|--yes) ;; # already parsed
    --all)
      echo -e "\n${BLUE}=======================================${NC}"
      echo -e "${GREEN}   DevPurge v${VERSION} Cache Sweep${NC}"
      echo -e "${BLUE}=======================================${NC}\n"
      for mod in "${CACHE_MODULES[@]}"; do run_if_allowed "$mod"; done
      ran_something=true
      ran_background=true # Signals to send notification
      ;;
    --install) install_daemon; exit 0 ;;
    --uninstall) uninstall_daemon; exit 0 ;;
    --help) show_help; exit 0 ;;
    --*) 
      # Dynamic flag checking
      mod_target="${arg#--}"
      found=false
      for mod in "${MODULES[@]}"; do
        if [ "$mod" == "$mod_target" ]; then
          run_if_allowed "$mod"
          found=true
          ran_something=true
          break
        fi
      done
      
      if [ "$found" = false ]; then
         echo -e "${RED}Unknown option or plugin: $arg${NC}"; show_help; exit 1
      fi
      ;;
    *) echo -e "${RED}Unknown option: $arg${NC}"; show_help; exit 1 ;;
  esac
done

if [ "$ran_something" = true ]; then
  if [ "$DRY_RUN" = true ]; then
    echo -e "\n${GREEN}[✔] Preview complete. No cleanup performed.${NC}"
  else
    echo -e "\n${GREEN}[✔] Requested cleanup finished; review any skipped targets above.${NC}"
  fi
  # Ping OS notifications if this was an automated sweep (to avoid annoying the user on targeted runs)
  if [ "$ran_background" = true ] && [ "$DRY_RUN" = false ]; then
    notify_desktop "Cache cleanup finished. Review logs for skipped targets."
  fi
fi
